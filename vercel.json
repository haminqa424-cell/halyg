{
  "rewrites": [
    { "source": "/api/trpc/:path*", "destination": "/api/trpc/:path*" },
    { "source": "/((?!api|assets|manus-storage|favicon).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
